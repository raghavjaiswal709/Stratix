# ─────────────────────────────────────────────────────────────────
# .env.local.example
# Copy the variables below into your .env.local (and Vercel settings).
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# ── Auth & Database ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/Stratix
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── MetaApi (server-side only — NEVER expose to browser) ─────────
# Obtain from app.metaapi.cloud → API access tokens
# ROTATE this token if it was ever committed to version control.
METAAPI_TOKEN=your_metaapi_token_here

# ── GitHub Actions trigger ────────────────────────────────────────
# Personal access token with `repo` + `workflow` scopes
# github.com/settings/tokens → Fine-grained tokens
GITHUB_TOKEN=ghp_your_token_here

# Your GitHub username (owner of the repo)
GITHUB_USERNAME=your_github_username

# Repository name (without the username prefix)
GITHUB_REPO=Stratix

# Branch to dispatch workflow_dispatch against (default: main)
# GITHUB_REF=main

# ── GitHub Actions secrets (repo → Settings → Secrets → Actions) ─
# Add these secrets in GitHub — do NOT put them in this file:
#   METAAPI_TOKEN   → same value as above
#   MONGODB_URI     → your Atlas connection string
#   ↳ Ensure Atlas IP allowlist includes 0.0.0.0/0 so runners connect

# ── AI Services ──────────────────────────────────────────────────
# OpenAI API key — platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Google Gemini API key — aistudio.google.com/app/apikey
# ROTATE this key if it was ever committed to version control.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Live Trading Dashboard ────────────────────────────────────────
# WebSocket URL for real-time price updates (frontend)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Backend server configurations (server/.env)
# FINNHUB_API_KEY=your_finnhub_free_api_key_here
# PORT=8080
# ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
